{
  "name": "@collector/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "collector-service": "./dist/host/cli.js"
  },
  "exports": {
    ".": {
      "@collector/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "@collector/source": "./src/host-entry.ts",
      "types": "./dist/host-entry.d.ts",
      "import": "./dist/host-entry.js"
    },
    "./wire": {
      "@collector/source": "./src/wire-entry.ts",
      "types": "./dist/wire-entry.d.ts",
      "import": "./dist/wire-entry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-host-assets.mjs && node ./scripts/ensure-host-ytdlp.mjs && node ./scripts/ensure-host-chromium.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "serve": "node ./dist/host/cli.js serve"
  },
  "dependencies": {
    "@collector/api": "*",
    "@collector/core": "*",
    "@collector/db": "*",
    "@collector/shared": "*",
    "@fontsource/golos-text": "5.2.8",
    "@huggingface/transformers": "^4.2.0",
    "@napi-rs/keyring": "^1.3.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^11.9.1",
    "katex": "0.18.4",
    "mermaid": "11.16.1",
    "playwright": "1.62.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "~5.8.3",
    "vitest": "^3.0.9"
  }
}
