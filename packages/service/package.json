{
  "name": "@collector/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "collector-service": "./dist/host/cli.js"
  },
  "exports": {
    ".": {
      "@collector/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "@collector/source": "./src/host-entry.ts",
      "types": "./dist/host-entry.d.ts",
      "import": "./dist/host-entry.js"
    },
    "./wire": {
      "@collector/source": "./src/wire-entry.ts",
      "types": "./dist/wire-entry.d.ts",
      "import": "./dist/wire-entry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-host-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "serve": "node ./dist/host/cli.js serve"
  },
  "dependencies": {
    "@collector/api": "*",
    "@collector/core": "*",
    "@collector/db": "*",
    "@collector/shared": "*",
    "@huggingface/transformers": "^4.2.0",
    "@napi-rs/keyring": "^1.3.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^11.9.1",
    "sharp": "^0.34.2",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "~5.8.3",
    "vitest": "^3.0.9"
  }
}
